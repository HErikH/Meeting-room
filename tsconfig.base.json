{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@UI/*": ["./src/components/UI/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@utils/*": ["./src/helpers/utils/*"],
      "@constants/*": ["./src/helpers/constants/*"],
      "@app-types/*": ["./src/helpers/types/*"]
    }
  }
}
